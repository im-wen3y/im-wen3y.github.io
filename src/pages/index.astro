---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeContent from '../components/HomeContent.astro';
import { getPublishedPosts, getTags } from '../lib/posts';

const posts = await getPublishedPosts();
const topics = getTags(posts);
---
<BaseLayout description="프론트엔드 개발 과정에서 고민하고, 시도하고, 배운 것들을 기록합니다.">
  <HomeContent posts={posts} topics={topics} recentPostCount={5} showBottomLink={true} />
</BaseLayout>
